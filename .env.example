# Optional. docker-compose works without this file; copy it to .env to override the defaults.
HOLD_DURATION_MINUTES=15
HOLD_SWEEP_INTERVAL_SECONDS=30
RABBITMQ_USER=inventory
RABBITMQ_PASSWORD=inventory-dev-only

# Request signing. Off by default so the API can be called directly; see "Security" in the README.
# When on, each secret must be 32+ characters. Generate one with: openssl rand -hex 32
HMAC_ENABLED=false
HMAC_WEB_SECRET=
HMAC_CHECKOUT_SECRET=
