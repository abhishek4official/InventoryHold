# Copy to .env on the server, next to deploy.sh. Never commit the real file.
# Generate each secret with: openssl rand -hex 32

# Required. Each HMAC secret must be 32+ characters.
RABBITMQ_PASSWORD=
HMAC_WEB_SECRET=
HMAC_CHECKOUT_SECRET=

# Optional. These are the defaults.
# RABBITMQ_USER=inventory
# WEB_PORT=80
# API_PORT=8080
# HOLD_DURATION_MINUTES=15
# HOLD_SWEEP_INTERVAL_SECONDS=30
# IMAGE_PREFIX=ghcr.io/abhishek4official/inventoryhold
