{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Holds": {
    "DefaultDurationMinutes": 15,
    "SweepIntervalSeconds": 30,
    "SweepBatchSize": 200,
    "ListLimit": 100
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "inventory_hold"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "inventory-hold:",
    "InventoryTtlSeconds": 30
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "inventory.holds",
    "Queue": "inventory-hold.events",
    "PublishTimeoutSeconds": 5
  }
}
